# Normalise line endings: LF in the repository and working tree, CRLF only where Windows needs it.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary

# Generated files: collapse in diffs
frontend/src/app/core/api/schema.generated.ts linguist-generated=true -diff
frontend/src/app/games/registry.generated.ts linguist-generated=true
docs/openapi.json linguist-generated=true
package-lock.json linguist-generated=true -diff
