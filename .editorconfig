# Shared editor settings (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 4
max_line_length = 100

[*.{gradle,xml,sql}]
indent_size = 4

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
